# Native development / managed deployment examples.
# The default local Docker workspace generates credentials and needs no .env file.
RETRIEVEC_DB_PASSWORD=replace-with-a-long-random-password
RETRIEVEC_READ_TOKEN=replace-with-a-different-random-token-at-least-24-characters
RETRIEVEC_WORKER_TOKEN=replace-with-another-random-token-at-least-24-characters
RETRIEVEC_OIDC_ISSUER=https://identity.example.com/realms/retrievec
RETRIEVEC_OIDC_SECRET=
RETRIEVEC_ORIGIN=http://127.0.0.1:8000
